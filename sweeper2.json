{
  "base": "config.json",
  "weeks": 4,
  "max_pairs": 200,
  "scan_interval_min": 15,

  "windows": [
    "2026-05-09",
    "2026-04-11",
    "2026-03-14"
  ],

  "params": {
    "scoring.BEST_MIN_SCORE":     [12, 13, 14, 15],
    "scoring.STRONG_MIN_SCORE":   [10, 11, 12],
    "indicators.ATR_MIN_PCT":     [1.5, 2.0, 2.5],
    "indicators.OBV_RISING_MIN":  [0.03, 0.05, 0.08],
    "indicators.CVD_BULLISH_MIN": [0.03, 0.05, 0.08],
    "scoring_hold.STRUCT_PENALTY": [0, 1, 2]
