    "quality":                   0.60,
    "volume":                    0.15,
    "rr":                        0.15,
    "volume_overflow_penalty":   0.40,
    "volume_overflow_threshold": 10
  },

  "out_dir": ".sweep_results2",
  "max_parallel_windows": 3
