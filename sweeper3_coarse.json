{
  "base": "config.json",
  "weeks": 2,
  "max_pairs": 150,
  "scan_interval_min": 15,

  "windows": [
    "2026-05-09",
    "2026-04-11",
    "2025-06-15",
    "2024-08-05"
  ],

  "params": {
    "scoring.BEST_MIN_SCORE":                [11, 13],
    "scoring.STRONG_MIN_SCORE":              [9, 11],
    "indicators.ATR_MIN_PCT":                [1.5, 2.5],
    "indicators.OBV_RISING_MIN":             [0.03, 0.12],
    "indicators.CVD_BULLISH_MIN":            [0.03, 0.08],
    "scoring_breakout.EARLY_ENTRY_BONUS":    [2, 3],
    "scoring_breakout.LATE_ENTRY_PENALTY":   [-1, -2],
    "scoring_hold.STRUCT_PENALTY":           [-3, -1]
  },

  "scoring_weights": {
    "catch":                     0.25,
    "quality":                   0.45,
    "volume":                    0.15,
    "rr":                        0.15,
    "volume_overflow_penalty":   0.20,
    "volume_overflow_threshold": 12,
    "inversion_penalty":         0.50
  },

  "out_dir": ".sweep_results3_coarse",
  "max_parallel_windows": 3
}
