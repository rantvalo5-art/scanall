{
  "base": "config.json",
  "weeks": 4,
  "max_pairs": 200,
  "scan_interval_min": 15,

  "windows": [
    "2026-05-09",
    "2026-04-25",
    "2026-04-11",
    "2026-03-28"
  ],

  "params": {
    "scoring.BEST_MIN_SCORE":     [11, 12],
    "scoring.STRONG_MIN_SCORE":   [9, 10],
    "indicators.ATR_MIN_PCT":     [1.5, 2.0],
    "indicators.OBV_RISING_MIN":  [0.02, 0.04],
    "indicators.CVD_BULLISH_MIN": [0.02, 0.05],
    "scoring_breakout.EARLY_ENTRY_BONUS": [2, 3],
    "scoring_breakout.LATE_ENTRY_PENALTY": [-1, -2],
    "scoring_hold.STRUCT_PENALTY": [0, 1, 2]
  },

  "scoring_weights": {
    "catch":                     0.25,
    "quality":                   0.45,
    "volume":                    0.15,
    "rr":                        0.15,
    "volume_overflow_penalty":   0.20,
    "volume_overflow_threshold": 12
  },

  "out_dir": ".sweep_optimized",
  "max_parallel_windows": 4
}