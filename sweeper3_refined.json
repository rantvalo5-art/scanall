{
  "_note": "Refined sweep post-coarse: zoom en knobs inestables. ATR_MIN_PCT ya promovido a 2.5 en config base.",
  "base": "config.json",
  "weeks": 3,
  "max_pairs": 200,
  "scan_interval_min": 15,

  "windows": [
    "2026-05-09",
    "2026-04-25",
    "2026-04-11",
    "2025-06-15",
    "2024-08-05"
  ],

  "params": {
    "scoring.BEST_MIN_SCORE":                [11, 12, 13],
    "scoring.STRONG_MIN_SCORE":              [9, 10],
    "indicators.OBV_RISING_MIN":             [0.03, 0.06, 0.09, 0.12],
    "scoring_hold.STRUCT_PENALTY":           [-3, -2, -1]
  },

  "scoring_weights": {
    "catch":                     0.25,
    "quality":                   0.45,
    "volume":                    0.15,
    "rr":                        0.15,
    "volume_overflow_penalty":   0.20,
    "volume_overflow_threshold": 12,
    "inversion_penalty":         0.50
  },

  "out_dir": ".sweep_results3_refined",
  "max_parallel_windows": 3
}
